{
  "expo": {
    "name": "Preuvio",
    "slug": "preuvio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "preuvio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "fr.preuvio.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Preuvio utilise l'appareil photo pour photographier les preuves de vos chantiers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F3A5F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.preuvio.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F3A5F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Preuvio utilise votre position pour trouver le chantier le plus proche.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Preuvio ouvre vos contacts pour choisir le client du chantier."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Preuvio ouvre vos photos pour ajouter une photo libre au chantier.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Preuvio utilise le micro pour dicter vos notes de chantier."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
