# Copier en .env.local. Valeurs publiques : la clé « publishable » est faite pour être
# embarquée dans l'appli, la RLS protège les données. Aucune autre clé ici.
#
# Local (pnpm exec supabase start) : l'URL et la clé s'affichent avec `pnpm exec supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Suivi en production (section 17), facultatif : sans valeur, rien n'est envoyé.
# Clé de projet PostHog (hébergement UE, « phc_… ») et DSN Sentry (région UE) : publics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
